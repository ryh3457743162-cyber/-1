# The server uses /etc/photo-ring.env (chmod 600), loaded by systemd.
# Never put real credentials in this file or commit the server environment file.
PHOTO_RING_SECRET=
PHOTO_RING_PASSWORD_HASH=

OSS_REGION=cn-shanghai
OSS_BUCKET=fanfan-hanhan-photos-1061513880
OSS_ENDPOINT=https://oss-cn-shanghai-internal.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Keep local until OSS test uploads and reads have passed.
OSS_UPLOAD_MODE=local
OSS_TEST_UPLOAD_ENABLED=0
